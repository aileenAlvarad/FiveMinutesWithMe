<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Contenido -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilContenidoEditar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contenido (emoji, frase, símbolo...)"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent_pink"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etContenidoEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:inputType="textMultiLine|textCapSentences" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Descripción -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDescripcionEditar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="¿Qué significa para ti?"
        android:layout_marginTop="8dp"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent_pink"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescripcionEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:inputType="textCapSentences" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>